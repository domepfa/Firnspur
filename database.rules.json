{
  "rules": {
    ".read": "auth != null && auth.token.email === 'firn@spur.so'",
    "$top": {
      "$a": {
        ".write": "auth != null && auth.token.email === 'firn@spur.so' && $top !== 'fixseil' && $top !== 'wandern' && $top !== 'versions'",
        ".validate": "!newData.exists() || ($top !== 'tours' && $top !== 'huts' && $top !== 'orte') || (newData.child('name').isString() && newData.child('name').val().length > 0)",
        "$b": {
          ".write": "auth != null && auth.token.email === 'firn@spur.so' && ($top === 'fixseil' || $top === 'wandern')",
          ".validate": "!newData.exists() || !(($top === 'fixseil' || $top === 'wandern') && $a === 'tours') || (newData.child('name').isString() && newData.child('name').val().length > 0)",
          "$c": {
            ".write": "auth != null && auth.token.email === 'firn@spur.so' && $top === 'versions' && !data.exists() && newData.exists()"
          }
        }
      }
    }
  }
}
